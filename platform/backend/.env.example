# Copy to .env (not committed) or set in your shell. No real secrets in this file.

# memory | firestore
STORAGE=memory
# mock | vertex-gemini | vertex-open | openai-compatible | vertex-claude
LLM_PROVIDER=mock
# none | bigquery
EVENT_SINK=none
TERM_START=2026-08-31
# Fixed clock for the demo data. Leave empty with STORAGE=firestore to use the real time.
DEMO_NOW=
PORT=8080

# vertex-gemini (auth via gcloud application-default login, no key)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# gemini-2.5-flash was retired on Oct 20, 2026; 3.5 Flash is current (check the model page before deploying)
GEMINI_MODEL=gemini-3.5-flash

# openai-compatible (vLLM, USF endpoint, or Ollama on this laptop)
# Local Llama through Ollama:
#   LLM_PROVIDER=openai-compatible
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=llama3.1:8b
#   OPENAI_API_KEY=ollama   (Ollama ignores it, but the client needs a value)
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=

# vertex-open (Model Garden endpoint, OpenAI-compatible URL)
VERTEX_OPEN_URL=
VERTEX_OPEN_MODEL=

# BigQuery sink
BQ_DATASET=cai3801
BQ_TABLE=events

# MCP over stdio (demo identity)
MCP_ROLE=ta
MCP_USER=ta_01
