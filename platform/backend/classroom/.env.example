# Classroom server settings. Copy to platform/backend/.env for local runs; on Cloud Run or Render,
# set these as environment variables or secrets. Never commit real values.

# Where data lives: libsql (Turso, for hosting), sqlite (one server with a disk), memory (tests)
CLASS_STORE=libsql
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=paste-the-token-from-turso

# First-run code for /setup. Pick a long random string; it stops working once the faculty account exists.
SETUP_TOKEN=change-me-to-something-long

# AI: leave as none. Everyone uses their own free Gemini key in their browser.
LLM_PROVIDER=none

# Behind HTTPS (Cloud Run, Render): on. The address people use, for invite and reset links.
COOKIE_SECURE=on
PUBLIC_URL=https://your-service-url
