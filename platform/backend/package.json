{
  "name": "cai3801-studio-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend scaffold for CAI 3801 Studio: shared rules, LLM providers, API, MCP server, GCP infra.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "dev": "node --env-file-if-exists=.env --watch api/server.js",
    "start": "node api/server.js",
    "mcp": "node --env-file-if-exists=.env mcp/stdio.js",
    "mcp:http": "node --env-file-if-exists=.env mcp/http.js",
    "classroom": "node --env-file-if-exists=.env classroom/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@google-cloud/bigquery": "^9.6.1",
    "@google-cloud/firestore": "^9.4.1",
    "@google/genai": "^3.6.1",
    "@libsql/client": "^0.18.0",
    "google-auth-library": "^11.3.4"
  }
}
